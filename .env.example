# The app itself needs no environment variables and no API key.
#
# CHINESE_POETRY_BASE is optional and only used by `npm run build:data`.
# It replaces the default download location of chinese-poetry:
#   https://raw.githubusercontent.com/chinese-poetry/chinese-poetry/b8594f81a89752241442f2ce267d6f66f96704ee/
# Use a mirror URL (http/https) or a local clone checked out at that commit.
#
# The script does not read .env files; set the variable in your shell:
#   PowerShell: $env:CHINESE_POETRY_BASE='<value>'; npm run build:data
#   bash:       CHINESE_POETRY_BASE='<value>' npm run build:data

CHINESE_POETRY_BASE=https://cdn.jsdelivr.net/gh/chinese-poetry/chinese-poetry@b8594f81a89752241442f2ce267d6f66f96704ee/
# Local clone instead:
# CHINESE_POETRY_BASE=D:/src/chinese-poetry
